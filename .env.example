# Copy to .env.local and fill in to enable "Sign in with GitHub" (handled by Better Auth).
# Create an OAuth App at https://github.com/settings/developers → OAuth Apps → New OAuth App
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The address you open the app at. Better Auth uses it for the callback URL, trusted origins, and to
# decide whether cookies are https-only — so it must match what's in your browser's address bar.
BETTER_AUTH_URL=http://localhost:3000

# Optional: Better Auth's encryption/signing key (generate with `openssl rand -base64 32`).
# Defaults to a key derived from GITHUB_CLIENT_SECRET.
# BETTER_AUTH_SECRET=

# Optional: server-wide token for public-repo API calls when nobody is signed in (raises the 60/hour limit).
# GITHUB_TOKEN=
